# Projeto Supabase: xhuaolnvuijeyruonkmg
# Copie para .env.supabase e preencha as conexões exibidas em Dashboard > Connect.
# Use a senha do BANCO em formato URL-encoded. A chave de API não é senha PostgreSQL.

# Aplicação: pooler transaction (porta 6543), com compatibilidade Prisma 5.
DATABASE_URL="postgresql://postgres.xhuaolnvuijeyruonkmg:CHANGE_ME_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&schema=vanessa"
# Migrações: pooler session (porta 5432); copie o host real do Dashboard.
# Também pode usar a conexão direta quando sua rede suporta IPv6.
DIRECT_URL="postgresql://postgres.xhuaolnvuijeyruonkmg:CHANGE_ME_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require&schema=vanessa"

SUPABASE_URL="https://xhuaolnvuijeyruonkmg.supabase.co"
SUPABASE_STORAGE_BUCKET="site-media"
SUPABASE_SECRET_KEY="CHANGE_ME_server_secret_key"
# Alternativa para projetos com chave JWT legada:
# SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME_legacy_service_role_key"
UPLOAD_PROVIDER="supabase"

JWT_SECRET="CHANGE_ME_generate_48_random_bytes"
ADMIN_EMAIL="admin@vanessarodrigues.adv.br"
ADMIN_PASSWORD="CHANGE_ME_at_least_12_characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TRUST_PROXY="false"
