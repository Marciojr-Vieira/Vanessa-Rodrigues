{
  "name": "vanessa-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "netlify:build": "node scripts/netlify-build.mjs",
    "supabase:heartbeat": "node --env-file=.env.supabase scripts/supabase-heartbeat.mjs",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "db:generate": "node scripts/database.mjs generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset-password": "node --env-file=.env --import tsx scripts/reset-password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "supabase:generate": "node --env-file=.env.supabase scripts/database.mjs generate",
    "supabase:migrate": "node --env-file=.env.supabase scripts/database.mjs migrate",
    "supabase:seed": "node --env-file=.env.supabase --import tsx prisma/seed.ts",
    "supabase:storage": "node --env-file=.env.supabase --import tsx scripts/supabase-storage.ts",
    "supabase:dev": "node scripts/supabase-next.mjs dev",
    "supabase:build": "npm run supabase:generate && node scripts/supabase-next.mjs build",
    "supabase:start": "node scripts/supabase-next.mjs start"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
